{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1",
    "^jsonwebtoken$": "<rootDir>/../node_modules/jsonwebtoken"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(@nestjs|uuid)/)"
  ]
}